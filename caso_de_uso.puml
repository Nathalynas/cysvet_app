@startuml
left to right direction
skinparam packageStyle rectangle

actor "Medico Veterinario" as Vet
actor "Administrador" as Admin

rectangle "Cysvet" {
  package "Acesso" {
    usecase "Fazer login" as UCLogin
    usecase "Selecionar empresa ativa" as UCCompany
  }

  package "Operacao tecnica" {
    usecase "Consultar dashboard reprodutivo" as UCDashboard
    usecase "Gerenciar propriedades" as UCProperties
    usecase "Gerenciar animais" as UCAnimals
    usecase "Consultar visitas e relatorios" as UCVisitReport
    usecase "Registrar visita tecnica" as UCVisitCreate
    usecase "Consultar historico do animal" as UCAnimalHistory
    usecase "Baixar PDF da visita" as UCVisitPdf
  }

  package "Administracao" {
    usecase "Criar conta inicial" as UCRegister
    usecase "Gerenciar equipe da empresa" as UCTeam
    usecase "Atualizar dados da empresa ativa" as UCCompanyUpdate
  }
}

Vet --> UCLogin
Vet --> UCCompany
Vet --> UCDashboard
Vet --> UCProperties
Vet --> UCAnimals
Vet --> UCVisitReport
Vet --> UCVisitCreate
Vet --> UCAnimalHistory

Admin --> UCRegister
Admin --> UCTeam
Admin --> UCCompanyUpdate

UCVisitPdf .> UCVisitReport : <<extend>>

@enduml
