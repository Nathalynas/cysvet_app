# O Caddy obtem e renova o certificado HTTPS (Let's Encrypt) para o dominio
# sozinho; o Android bloqueia HTTP sem TLS por padrao.
{$DOMAIN} {
	encode gzip

	# APK e versao.json publicados por publicar-apk.sh; o app consulta para se atualizar.
	handle_path /app/* {
		root * /srv/app
		header /versao.json Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy backend:8080
	}
}
