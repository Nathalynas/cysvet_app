# Copie para .env (que fica fora do Git) e preencha. Nunca versione o .env.

# Dominio apontando para o IP publico da VM (ex.: subdominio gratuito do DuckDNS).
DOMAIN=cysvet.duckdns.org

# Banco. Gere senhas fortes: openssl rand -base64 24
MYSQL_USER=cysvet
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Assinatura dos tokens (minimo 32 bytes): openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-bytes

# Obrigatorio no perfil prod. O app mobile nao usa CORS; informe a origem da versao web, se houver.
APP_CORS_ALLOWED_ORIGINS=https://cysvet.duckdns.org
